{
  "name": "palleta-photo-private",
  "main": "src/index.js",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "palleta-photo-private"
    }
  ],
  "observability": {
    "enabled": true
  }
}
